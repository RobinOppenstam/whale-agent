# Railway Database Configuration
# Railway will auto-inject DATABASE_URL, but you can also use individual vars
DATABASE_URL=postgresql://user:password@host:port/database
# Or use Railway's provided variables:
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# RPC Configuration (Base Network)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_api_key_here
# Backup RPC
BASE_RPC_BACKUP=https://mainnet.base.org

# The Graph Configuration (optional - will construct endpoint automatically)
# GRAPH_API_KEY=your_graph_api_key_here

# Token Addresses to Track
TOKENS=0x0b3AE50BaBE7FFa4E1A50569ceE6bDEFd4ccAeE0,0x1C4CcA7C5DB003824208aDDA61Bd749e55F463a3

# Schedule (cron format - default: every 6 hours)
ANALYSIS_SCHEDULE=0 */6 * * *

# Report Settings
BACKFILL_DAYS=30
WHALE_THRESHOLD_PERCENTAGE=1.0
